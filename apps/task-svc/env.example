# task-svc environment overrides.
#
# At startup the service auto-loads:
#   1. <repo-root>/.env   (preferred — same place the Nest services read)
#   2. apps/task-svc/.env (per-service override)
# The first file that exists wins. You can also export these in your shell.

# ── Database ───────────────────────────────────────────────────────────────
# Postgres connection string. Both libpq URI form and Npgsql key/value form
# are accepted. Examples:
#
#   Local Postgres:
#     TASK_DATABASE_URL=Host=localhost;Port=5432;Database=tasks;Username=tasks;Password=tasks
#
#   Neon (URI form, copy from the Neon console):
#     TASK_DATABASE_URL=postgresql://user:pass@ep-xyz.eu-central-1.aws.neon.tech/tasks?sslmode=require
#
TASK_DATABASE_URL=

# ── Optional ───────────────────────────────────────────────────────────────
# Override hosting environment + listen port. Defaults are set in
# Properties/launchSettings.json (Development, port 3004) when launched via
# `dotnet run` or `pnpm dev:task`.
# ASPNETCORE_ENVIRONMENT=Development
# ASPNETCORE_HTTP_PORTS=3004

# Comma-separated list, e.g. https://app.example.com,https://admin.example.com.
# Leave empty to allow any origin (development only).
# Cors__AllowedOrigins__0=
