# task-svc environment overrides.
#
# At startup the service auto-loads:
#   1. <repo-root>/.env   (preferred — same place the Nest services read)
#   2. apps/task-svc/.env (per-service override)
# The first file that exists wins. You can also export these in your shell.

# ── Database ───────────────────────────────────────────────────────────────
# Postgres connection string. Both libpq URI form and Npgsql key/value form
# are accepted. Examples:
#
#   Local Postgres:
#     TASK_DATABASE_URL=Host=localhost;Port=5432;Database=tasks;Username=tasks;Password=tasks
#
#   Neon (URI form, copy from the Neon console):
#     TASK_DATABASE_URL=postgresql://user:pass@ep-xyz.eu-central-1.aws.neon.tech/tasks?sslmode=require
#
TASK_DATABASE_URL=

# ── Cache (optional) ───────────────────────────────────────────────────────
# Distributed cache used for cache-aside on `GET /api/tasks/{id}`. When
# REDIS_URL is unset the service falls back to an in-memory cache (works for
# local dev, but doesn't survive restarts and can't be shared across replicas).
#
# Both URI form (Upstash, Redis Cloud, …) and StackExchange.Redis key/value
# form are accepted:
#
#   Upstash:
#     REDIS_URL=rediss://default:<password>@<region>.upstash.io:6379
#
#   Local docker:
#     REDIS_URL=localhost:6379
#
# REDIS_URL=

# Override the rate-limit knobs without redeploying. Values shown are the
# defaults in appsettings.json.
# RateLimiting__Read__PermitLimit=100
# RateLimiting__Read__WindowSeconds=60
# RateLimiting__Write__PermitLimit=20
# RateLimiting__Write__WindowSeconds=60

# Override the cache key prefix or TTL.
# Caching__KeyPrefix=task-svc:
# Caching__TtlSeconds=300

# ── Kafka (optional) ───────────────────────────────────────────────────────
# Consumes `OrderCreated` from order-svc (same broker credentials as the Nest
# stack — copy KAFKA_* from the repo-root `.env`). When `KAFKA_BROKERS` is
# unset, the consumer does not start (manual tasks via REST still work).
#
# Ensure topic exists (once): `node scripts/ensure-kafka-topic.mjs`
#
# **Aiven mTLS (recommended — same vars as shop-/order-svc):** copy the four
# lines from the repo-root `.env`: `KAFKA_BROKERS`, `KAFKA_SSL_CA`,
# `KAFKA_SSL_CERT`, `KAFKA_SSL_KEY`. Multi-line quoted PEM blobs are supported.
# When all three PEMs are present, task-svc uses **SSL + client certificate**
# (not SASL), matching `packages/shared/src/kafka.ts`.
#
# KAFKA_BROKERS=kafka-xxxx.aivencloud.com:27782
# KAFKA_SSL_CA="-----BEGIN CERTIFICATE----- ..."
# KAFKA_SSL_CERT="-----BEGIN CERTIFICATE----- ..."
# KAFKA_SSL_KEY="-----BEGIN PRIVATE KEY----- ..."
#
# **SASL (alternative):** username/password + optional CA only — used only if
# you do **not** supply all three PEMs above.
# KAFKA_USERNAME=avnadmin
# KAFKA_PASSWORD=...
# KAFKA_SASL_MECHANISM=scram-sha-256
#
# If hostname verification fails against the broker SAN, try:
# KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=none
#
# Topic/group (defaults shown — must match order-svc publisher):
# KAFKA_ORDER_EVENTS_TOPIC=order-events
# KAFKA_TASK_SVC_GROUP_ID=task-svc
#
# Disable without removing broker settings:
# KAFKA_ORDER_CONSUMER_ENABLED=false

# ── Optional ───────────────────────────────────────────────────────────────
# Override hosting environment + listen port. Defaults are set in
# Properties/launchSettings.json (Development, port 3004) when launched via
# `dotnet run` or `pnpm dev:task`.
# ASPNETCORE_ENVIRONMENT=Development
# ASPNETCORE_HTTP_PORTS=3004

# Comma-separated list, e.g. https://app.example.com,https://admin.example.com.
# Leave empty to allow any origin (development only).
# Cors__AllowedOrigins__0=
